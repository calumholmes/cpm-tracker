# cpm-tracker secrets. Copy this file to ".env" and fill it in.
# Never share or commit your .env. Anyone with the token controls your bot.

# Required: Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# Optional but recommended: your server's ID, so slash commands appear instantly.
# Discord > User Settings > Advanced > Developer Mode, then right-click your server > Copy Server ID
DISCORD_GUILD_ID=
